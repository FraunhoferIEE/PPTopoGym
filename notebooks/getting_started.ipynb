    "     \"start_time\": \"2025-09-10T21:10:14.601107Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# net = case2869pegase()\\n\",\n",
    "    \"net = case14()\\n\",\n",
    "    \"vthresh = 0.0  # 110. # 380.\\n\",\n",
    "    \"\\n\",\n",
    "    \"net.line[\\\"vn_kv\\\"] = pd.merge(\\n\",\n",
    "    \"    net.line, net.bus, left_on=\\\"from_bus\\\", right_index=True, how=\\\"left\\\"\\n\",\n",
    "    \")[\\\"vn_kv\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"net.bus[\\\"nlines\\\"] = 0.0\\n\",\n",
    "    \"for bus in net.bus.index.tolist():\\n\",\n",
    "    \"    net.bus.loc[bus, \\\"n_elements\\\"] = n_assignable_elements_in_bus(net, bus)\\n\",\n",
    "    \"    net.bus.loc[bus, \\\"is_dbbs\\\"] = can_convert_to_n_busbar_substation(net, bus)\\n\",\n",
    "    \"\\n\",\n",
    "    \"example_substations = net.bus[net.bus[\\\"is_dbbs\\\"] == True].index.tolist()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Geodata taken from Grid 2 Op for familiarity.\\n\",\n",
    "    \"# This is the \\\"x\\\", \\\"y\\\" Dataframe that we are familiar with from Pandapower 2.0\\n\",\n",
    "    \"df_bus_geodata = pd.DataFrame(\\n\",\n",
    "    \"    {\\n\",\n",
    "    \"        0: [-280.0, -81.0],\\n\",\n",
    "    \"        1: [-100.0, -270.0],\\n\",\n",
    "    \"        2: [366.0, -270.0],\\n\",\n",
    "    \"        3: [366.0, -54.0],\\n\",\n",
    "    \"        4: [-64.0, -54.0],\\n\",\n",
    "    \"        5: [-64.0, 54.0],\\n\",\n",
    "    \"        6: [450.0, 0.0],\\n\",\n",
    "    \"        7: [550.0, 0.0],\\n\",\n",
    "    \"        8: [326.0, 54.0],\\n\",\n",
    "    \"        9: [222.0, 108.0],\\n\",\n",
    "    \"        10: [79.0, 162.0],\\n\",\n",
    "    \"        11: [-170.0, 270.0],\\n\",\n",
    "    \"        12: [-64.0, 270.0],\\n\",\n",
    "    \"        13: [222.0, 216.0],\\n\",\n",
    "    \"    },\\n\",\n",
    "    \"    index=[\\\"x\\\", \\\"y\\\"],\\n\",\n",
    "    \").T\\n\",\n",
    "    \"\\n\",\n",
    "    \"net.bus.geo = create_geo_column_from_xy(df_bus_geodata)\\n\",\n",
    "    \"\\n\",\n",
    "    \"calculate_externals_locations(net, offset=55)\\n\",\n",
    "    \"\\n\",\n",
    "    \"orig_net = copy.deepcopy(net)\"\n",
    "   ],\n",
