    "   \"source\": [\n",
    "    \"from gymnasium import spaces\\n\",\n",
    "    \"from pandapower_env.substation.double_busbar_substation import (\\n\",\n",
    "    \"    get_list_of_closed_and_open_substation_switches,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"class my_custom_env(BaseEnvPP):\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __init__(self, env_config):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Initialize the my_custom_env environment.\\n\",\n",
    "    \"        Note that env_config must be a serializable dict in order to be e.g. used in a RLLib-style\\n\",\n",
    "    \"        environment that sends jobs to a batch system.\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Required configuration keys in env_config:\\n\",\n",
    "    \"         - 'net' (from gym_env_pp): pp.pandapowerNet or path to pandapower network file\\n\",\n",
    "    \"         - 'n_episodes' (from gym_env_pp): Number of episodes to run\\n\",\n",
    "    \"         - 'action_space': A dictionary corresponding to the action space\\n\",\n",
    "    \"\\n\",\n",
    "    \"        :param env_config: environment configuration\\n\",\n",
    "    \"        :type env_config: dict\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        super().__init__(env_config)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        self.df_actions = self.create_actions_df(env_config[\\\"action_space\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Define action space:\\n\",\n",
    "    \"        self.action_space = spaces.Discrete(len(self.df_actions))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Define observation space:\\n\",\n",
    "    \"        self.observation_space = self.define_observation_space()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def calculate_open_and_closed_switches(self, dict_actions):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Add key-value pairs 'open_switches' and 'closed_switches' to the actions dictionary\\n\",\n",
    "    \"        to determine the switch operations that correspond to the substation action.\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for action in dict_actions:\\n\",\n",
    "    \"            action[\\\"open_switches\\\"] = []\\n\",\n",
    "    \"            action[\\\"closed_switches\\\"] = []\\n\",\n",
    "    \"            for i_sub, state in zip(action[\\\"substations\\\"], action[\\\"states\\\"]):\\n\",\n",
    "    \"                closed_switches, open_switches = get_list_of_closed_and_open_substation_switches(\\n\",\n",
    "    \"                    self.net, i_sub, state\\n\",\n",
    "    \"                )\\n\",\n",
    "    \"                action[\\\"open_switches\\\"].extend(open_switches)\\n\",\n",
    "    \"                action[\\\"closed_switches\\\"].extend(closed_switches)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def create_actions_df(self, dict_actions):\\n\",\n",
    "    \"\\n\",\n",
    "    \"        self.calculate_open_and_closed_switches(dict_actions)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        df_actions = pd.DataFrame(dict_actions)\\n\",\n",
    "    \"        df_actions = df_actions[\\n\",\n",
    "    \"            [\\n\",\n",
    "    \"                \\\"substations\\\",\\n\",\n",
    "    \"                \\\"states\\\",\\n\",\n",
    "    \"                \\\"open_switches\\\",\\n\",\n",
    "    \"                \\\"closed_switches\\\",\\n\",\n",
    "    \"            ]\\n\",\n",
    "    \"        ]\\n\",\n",
    "    \"        df_actions.index.name = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return df_actions\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def load_action(self, action):\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # reset all switches in the network\\n\",\n",
    "    \"        self.net.switch[\\\"closed\\\"] = True\\n\",\n",
    "    \"\\n\",\n",
    "    \"        open_switches = self.df_actions.loc[action, \\\"open_switches\\\"]\\n\",\n",
    "    \"        self.net.switch.loc[open_switches, \\\"closed\\\"] = False\\n\",\n",
    "    \"        return\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def define_observation_space(self):\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # The example here is the line loading (%) of each line\\n\",\n",
    "    \"        return spaces.Box(\\n\",\n",
    "    \"            low=0, high=200, shape=(len(self.net.line),), dtype=np.float32\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def create_observation(self, run_pf = True):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        This function will be called by the \\\"step\\\" function.\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"        observation = np.clip(self.net.res_line[\\\"loading_percent\\\"], 0, 200).tolist()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return observation\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def calculate_reward(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        This is a simple example of a reward: minimizing the loading of\\n\",\n",
    "    \"        all of the lines (trying to prevent one or more lines from overloading).\\n\",\n",
    "    \"\\n\",\n",
    "    \"        :param net: the pandapower network\\n\",\n",
    "    \"        :type net: pandapowerNet\\n\",\n",
    "    \"        :return: reward\\n\",\n",
    "    \"        :rtype: float\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"        max_loading = self.net.res_line[\\\"loading_percent\\\"].max()\\n\",\n",
    "    \"        reward = -max_loading\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return reward\"\n",
    "   ],\n",
