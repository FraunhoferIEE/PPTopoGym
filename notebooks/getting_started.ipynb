    "     \"start_time\": \"2025-09-10T21:10:18.085993Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"def get_profile_names(df_profile):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Quick function to get the names of each of the profiles offered by Simbench\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    return (\\n\",\n",
    "    \"        df_profile.columns[1:]\\n\",\n",
    "    \"        .to_series()\\n\",\n",
    "    \"        .apply(lambda x: x.replace(\\\"_pload\\\", \\\"\\\").replace(\\\"_qload\\\", \\\"\\\"))\\n\",\n",
    "    \"        .unique()\\n\",\n",
    "    \"    )\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 13\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"22\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-10T21:10:18.138190Z\",\n",
    "     \"start_time\": \"2025-09-10T21:10:18.118089Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Randomly select some profiles to load.\\n\",\n",
    "    \"rng = np.random.default_rng(seed=12345)\\n\",\n",
    "    \"net.load[\\\"profile\\\"] = rng.choice(get_profile_names(net.profiles[\\\"load\\\"]), len(net.load))\\n\",\n",
    "    \"net.gen[\\\"profile\\\"] = rng.choice(\\n\",\n",
    "    \"    get_profile_names(net.profiles[\\\"powerplants\\\"]), len(net.gen)\\n\",\n",
    "    \")\\n\",\n",
    "    \"# net.sgen['profile'] = rng.choice(get_profile_names(net.profiles['renewables']),len(net.sgen))\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 14\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"23\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-10T21:10:18.169681Z\",\n",
    "     \"start_time\": \"2025-09-10T21:10:18.153919Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Make sure loads, generators each have unique names\\n\",\n",
    "    \"net.gen[\\\"name\\\"] = net.gen.index.to_series().apply(lambda x: f\\\"Generator {x}\\\")\\n\",\n",
    "    \"net.sgen[\\\"name\\\"] = net.sgen.index.to_series().apply(lambda x: f\\\"Static Generator {x}\\\")\\n\",\n",
    "    \"net.load[\\\"name\\\"] = net.load.index.to_series().apply(lambda x: f\\\"Load {x}\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
