    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"fig, ax = plt.subplots(1, 1, figsize=(10, 10))\\n\",\n",
    "    \"\\n\",\n",
    "    \"bus_size = 8\\n\",\n",
    "    \"\\n\",\n",
    "    \"all_collections = []\\n\",\n",
    "    \"line_c = plot.create_line_collection(\\n\",\n",
    "    \"    orig_net,\\n\",\n",
    "    \"    orig_net.line[orig_net.line[\\\"vn_kv\\\"] >= vthresh].index,\\n\",\n",
    "    \"    color=\\\"silver\\\",\\n\",\n",
    "    \"    zorder=2,\\n\",\n",
    "    \"    linewidths=1,\\n\",\n",
    "    \")\\n\",\n",
    "    \"bus_c = plot.create_bus_collection(\\n\",\n",
    "    \"    orig_net,\\n\",\n",
    "    \"    orig_net.bus[orig_net.bus[\\\"vn_kv\\\"] >= vthresh].index,\\n\",\n",
    "    \"    color=\\\"lightsteelblue\\\",\\n\",\n",
    "    \"    size=bus_size,\\n\",\n",
    "    \"    zorder=3,\\n\",\n",
    "    \")\\n\",\n",
    "    \"sub_c = plot.create_bus_collection(\\n\",\n",
    "    \"    orig_net, example_substations, color=\\\"darksalmon\\\", size=bus_size * 1.5, zorder=4\\n\",\n",
    "    \")\\n\",\n",
    "    \"trafo_c = plot.create_trafo_collection(\\n\",\n",
    "    \"    orig_net,\\n\",\n",
    "    \"    orig_net.trafo[orig_net.trafo[\\\"vn_lv_kv\\\"] >= vthresh].index,\\n\",\n",
    "    \"    color=\\\"dimgray\\\",\\n\",\n",
    "    \"    size=bus_size,\\n\",\n",
    "    \"    linewidths=1,\\n\",\n",
    "    \")\\n\",\n",
    "    \"ext_c = plot.create_bus_collection(\\n\",\n",
    "    \"    orig_net,\\n\",\n",
    "    \"    orig_net.ext_grid.index,\\n\",\n",
    "    \"    patch_type=\\\"rect\\\",\\n\",\n",
    "    \"    size=bus_size * 2.0,\\n\",\n",
    "    \"    color=\\\"y\\\",\\n\",\n",
    "    \"    zorder=2,\\n\",\n",
    "    \")\\n\",\n",
    "    \"loads_c = plot.create_load_collection(orig_net, size=2 * bus_size, orientation=3.14 / 3)\\n\",\n",
    "    \"gen_c = plot.create_gen_collection(\\n\",\n",
    "    \"    orig_net, size=2 * bus_size, orientation=2 * 3.14 / 3\\n\",\n",
    "    \")\\n\",\n",
    "    \"for c in [line_c, bus_c, sub_c, trafo_c, ext_c]:  # ,loads_c,gen_c] :\\n\",\n",
    "    \"    if c != None:\\n\",\n",
